# Release archives (GitHub's source zip of a tag, which the extension manager installs) carry only
# the plugin, its README and the headless example; tooling, tests and screenshots stay in git.
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/tests export-ignore
/docs export-ignore
/pyproject.toml export-ignore
/CONTRIBUTING.md export-ignore
/CODE_OF_CONDUCT.md export-ignore
/SECURITY.md export-ignore
